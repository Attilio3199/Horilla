# Copia questo file in .env e compila i valori

# Django
DEBUG=False
SECRET_KEY=cambia_questa_secret_key_con_una_stringa_casuale_lunga
ALLOWED_HOSTS=www.example.com,example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com
TIME_ZONE=Europe/Rome

# Database Configuration
# Usa DATABASE_URL oppure i singoli campi DB_* (non entrambi)
#DATABASE_URL=postgresql://user:password@localhost:5432/dbname

DB_INIT_PASSWORD=cambia_questa_password_di_init
DB_DUMP_PATH=./horilla_main.dump
DB_ENGINE=django.db.backends.postgresql
DB_NAME=horilla_main
DB_USER=horilla
DB_PASSWORD=cambia_questa_password
DB_HOST=localhost
DB_PORT=5432
# Nota: in docker DB_HOST viene sovrascritto automaticamente a "db"

# Porte
APP_PORT=8001
DOCKER_PORT=8000

# Path dove vengono salvati i file media caricati
MEDIA_ROOT=/percorso/alla/cartella/media/

# GCP Storage per i Media (opzionale)
# GOOGLE_APPLICATION_CREDENTIALS=percorso/al/service-account.json
# GS_BUCKET_NAME=nome-del-bucket
# DEFAULT_FILE_STORAGE=horilla.horilla_backends_gcp.PrivateMediaStorage
# MEDIA_URL=https://storage.cloud.google.com/nome-del-bucket/media
# NAMESPACE=private
